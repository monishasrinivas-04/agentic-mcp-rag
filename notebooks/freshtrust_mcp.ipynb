def diversify_retrieved_chunks(
    ranked_chunks,
    max_chunks=3,
    max_line_overlap=0.50,
):
    """
    Retain high-ranked chunks while reducing near-duplicate
    evidence based on their source line ranges.
    """
    selected = []

    for candidate in ranked_chunks:
        c_start = candidate["start_line"]
        c_end = candidate["end_line"]
        c_length = max(1, c_end - c_start + 1)

        redundant = False

        for existing in selected:
            e_start = existing["start_line"]
            e_end = existing["end_line"]

            overlap = max(
                0,
                min(c_end, e_end) - max(c_start, e_start) + 1,
            )

            e_length = max(1, e_end - e_start + 1)
            overlap_ratio = overlap / min(c_length, e_length)

            if overlap_ratio > max_line_overlap:
                redundant = True
                break

        if not redundant:
            selected.append(candidate)

        if len(selected) >= max_chunks:
            break

    return selected


