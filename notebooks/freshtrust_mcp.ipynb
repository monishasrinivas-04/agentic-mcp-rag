# 7. Reusable single-file MCP RAG pipeline
# ---------------------------------------------------------

async def freshtrust_rag_v2(
    question,
    source_path=DEFAULT_SOURCE_PATH,
    top_k=DEFAULT_TOP_K,
    max_new_tokens=MAX_NEW_TOKENS
):
    """
    Fetch one repository file through GitHub MCP, retrieve
    relevant structure-aware chunks, generate a grounded
    answer with the loaded Qwen model, and log latency.
    """
    total_start = time.perf_counter()

    # Fetch through the existing authenticated MCP session.
    mcp_start = time.perf_counter()

    from kaggle_secrets import UserSecretsClient
    from mcp import ClientSession
    from mcp.client.streamable_http import streamablehttp_client

    token = UserSecretsClient().get_secret(
        "GITHUB_PERSONAL_ACCESS_TOKEN"
    )

    headers = {"Authorization": f"Bearer {token}"}

    async with streamablehttp_client(
        GITHUB_MCP_URL,
        headers=headers
    ) as (read_stream, write_stream, _):
        async with ClientSession(read_stream, write_stream) as session:
            await session.initialize()

            source = await get_mcp_file(session, source_path)

    mcp_seconds = time.perf_counter() - mcp_start

    if not isinstance(source, str) or not source.strip():
        raise ValueError(
            f"MCP returned no readable source for {source_path}. "
            "No direct REST API fallback was attempted."
        )

    # Parse the source and rank its chunks.
    retrieval_start = time.perf_counter()

    chunks = chunk_python_source_v2(source, source_path)
    ranked = rank_chunks(question, chunks)
    evidence = select_diverse_chunks(ranked, top_k=top_k)

    retrieval_seconds = time.perf_counter() - retrieval_start

    if not evidence:
        raise ValueError(
            f"No retrievable chunks found in {source_path}."
        )

    prompt = build_rag_prompt(question, evidence)

    # Use the already-loaded Qwen3-14B model.
    generation_start = time.perf_counter()

    inputs = tokenizer(
        prompt,
        return_tensors="pt",
        truncation=True,
        max_length=6000
    ).to(model.device)

    prompt_tokens = int(inputs["input_ids"].shape[1])

    with torch.inference_mode():
        output = model.generate(
            **inputs,
            max_new_tokens=max_new_tokens,
            do_sample=False,
            pad_token_id=tokenizer.eos_token_id
        )

    generated_ids = output[0][prompt_tokens:]
    generated_tokens = int(generated_ids.shape[0])

    answer = tokenizer.decode(
        generated_ids,
        skip_special_tokens=True
    ).strip()

    generation_seconds = time.perf_counter() - generation_start
    total_seconds = time.perf_counter() - total_start

    # Record exact evidence provenance for later auditing.
    evidence_metadata = [
        {
            "path": c["path"],
            "section": c["name"],
            "start_line": c["start_line"],
            "end_line": c["end_line"],
            "similarity": round(c["similarity"], 4),
        }
        for c in evidence
    ]

    metrics = {
        "timestamp_utc": datetime.now(timezone.utc).isoformat(),
        "question": question,
        "source_path": source_path,
        "source_chars": len(source),
        "total_chunks": len(chunks),
        "retrieved_chunks": len(evidence),
        "prompt_tokens": prompt_tokens,
        "generated_tokens": generated_tokens,
        "mcp_seconds": round(mcp_seconds, 3),
        "retrieval_seconds": round(retrieval_seconds, 3),
        "generation_seconds": round(generation_seconds, 3),
        "total_seconds": round(total_seconds, 3),
        "evidence": str(evidence_metadata),
    }

    append_rag_metrics(metrics)

    return {
        "answer": answer,
        "evidence": evidence_metadata,
        "metrics": metrics,
    }


