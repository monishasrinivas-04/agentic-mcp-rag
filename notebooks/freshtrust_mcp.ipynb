import os
import json
import hashlib
from datetime import datetime, timezone

CACHE_PATH = "/kaggle/working/freshtrust_file_cache.json"
CACHE_TTL_SECONDS = 300


def _load_file_cache():
    if not os.path.exists(CACHE_PATH):
        return {}
    try:
        with open(CACHE_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def _save_file_cache(cache):
    temporary = CACHE_PATH + ".tmp"
    with open(temporary, "w", encoding="utf-8") as f:
        json.dump(cache, f)
    os.replace(temporary, CACHE_PATH)


def _cache_key(path):
    identity = f"{OWNER}/{REPO}/{path}"
    return hashlib.sha256(identity.encode()).hexdigest()


def _content_hash(content):
    return hashlib.sha256(content.encode("utf-8")).hexdigest()


def _cache_age(entry):
    try:
        fetched = datetime.fromisoformat(entry["fetched_at"])
        if fetched.tzinfo is None:
            fetched = fetched.replace(tzinfo=timezone.utc)
        return (
            datetime.now(timezone.utc) - fetched
        ).total_seconds()
    except (KeyError, ValueError, TypeError):
        return float("inf")


def get_cached_file(path):
    entry = _load_file_cache().get(_cache_key(path))

    if not entry or not isinstance(entry.get("content"), str):
        return None

    age = _cache_age(entry)

    if 0 <= age < CACHE_TTL_SECONDS:
        return {
            "path": path,
            "source": entry["content"],
            "cache_status": "cache_hit_not_revalidated",
            "content_hash": entry["content_hash"],
            "fetched_at": entry["fetched_at"],
        }

    return None


def get_stale_cached_file(path):
    entry = _load_file_cache().get(_cache_key(path))

    if not entry or not isinstance(entry.get("content"), str):
        return None

    return {
        "path": path,
        "source": entry["content"],
        "cache_status": "stale_fallback_not_revalidated",
        "content_hash": entry.get("content_hash"),
        "fetched_at": entry.get("fetched_at"),
    }


def store_cached_file(path, content):
    cache = _load_file_cache()
    entry = {
        "path": path,
        "content": content,
        "content_hash": _content_hash(content),
        "fetched_at": datetime.now(timezone.utc).isoformat(),
    }

    cache[_cache_key(path)] = entry
    _save_file_cache(cache)

    return {
        "path": path,
        "source": content,
        "cache_status": "fetched_live",
        "content_hash": entry["content_hash"],
        "fetched_at": entry["fetched_at"],
    }


print("Cache helpers ready.")
print("TTL:", CACHE_TTL_SECONDS, "seconds")
print("Cache file:", CACHE_PATH)




import time
import torch
from kaggle_secrets import UserSecretsClient
from mcp import ClientSession
from mcp.client.streamable_http import streamablehttp_client


async def freshtrust_rag_multi_cached(
    question,
    max_files=4,
    top_k=5,
    max_new_tokens=180,
):
    total_start = time.perf_counter()

    candidate_files = select_repository_files(
        question, max_files=max_files
    )

    retrieved_files = []
    fetch_errors = []
    cache_events = []
    files_to_fetch = []

    # Reuse files whose cache entries have not expired.
    for path in candidate_files:
        cached = get_cached_file(path)

        if cached is not None:
            retrieved_files.append(cached)
            cache_events.append({
                "path": path,
                "status": cached["cache_status"],
            })
        else:
            files_to_fetch.append(path)

    mcp_start = time.perf_counter()

    # Contact MCP only if at least one file needs fetching.
    if files_to_fetch:
        token = UserSecretsClient().get_secret(
            "GITHUB_PERSONAL_ACCESS_TOKEN"
        )
        headers = {"Authorization": f"Bearer {token}"}

        async with streamablehttp_client(
            GITHUB_MCP_URL,
            headers=headers,
        ) as (read_stream, write_stream, _):
            async with ClientSession(
                read_stream, write_stream
            ) as session:
                await session.initialize()

                for path in files_to_fetch:
                    try:
                        source = await get_mcp_file(session, path)

                        if not isinstance(source, str) or not source.strip():
                            raise ValueError(
                                "MCP returned no readable source"
                            )

                        saved = store_cached_file(path, source)
                        retrieved_files.append(saved)

                        cache_events.append({
                            "path": path,
                            "status": saved["cache_status"],
                        })

                    except Exception as exc:
                        stale = get_stale_cached_file(path)

                        if stale is not None:
                            retrieved_files.append(stale)
                            cache_events.append({
                                "path": path,
                                "status": stale["cache_status"],
                            })
                            fetch_errors.append({
                                "path": path,
                                "error": "MCP failed; stale cache used: "
                                         + str(exc)[:180],
                            })
                        else:
                            fetch_errors.append({
                                "path": path,
                                "error": str(exc)[:250],
                            })
                            cache_events.append({
                                "path": path,
                                "status": "fetch_failed_no_cache",
                            })

    mcp_seconds = time.perf_counter() - mcp_start

    if not retrieved_files:
        raise RuntimeError(
            "No repository files could be retrieved. "
            f"Candidate files: {candidate_files}. "
            f"Errors: {fetch_errors}"
        )

    retrieval_start = time.perf_counter()

    all_chunks = []
    for item in retrieved_files:
        chunks = chunk_repository_file(
            item["source"], item["path"]
        )

        # Carry cache freshness status into the evidence metadata.
        for chunk in chunks:
            chunk["cache_status"] = item["cache_status"]
            chunk["content_hash"] = item["content_hash"]
            chunk["fetched_at"] = item["fetched_at"]

        all_chunks.extend(chunks)

    ranked_chunks = rank_chunks(question, all_chunks)
    evidence = select_diverse_chunks(ranked_chunks, top_k=top_k)

    retrieval_seconds = time.perf_counter() - retrieval_start

    if not evidence:
        raise RuntimeError("No relevant evidence chunks were selected.")

    prompt = build_rag_prompt(question, evidence) + "\n/no_think"

    generation_start = time.perf_counter()

    inputs = tokenizer(
        prompt,
        return_tensors="pt",
        truncation=True,
        max_length=6000,
    ).to(model.device)

    prompt_tokens = int(inputs["input_ids"].shape[1])

    with torch.inference_mode():
        output = model.generate(
            **inputs,
            max_new_tokens=max_new_tokens,
            do_sample=False,
            pad_token_id=tokenizer.eos_token_id,
        )

    generated_ids = output[0][prompt_tokens:]
    answer = tokenizer.decode(
        generated_ids,
        skip_special_tokens=True,
    ).strip()

    generation_seconds = time.perf_counter() - generation_start
    total_seconds = time.perf_counter() - total_start

    evidence_metadata = [
        {
            "path": chunk["path"],
            "section": chunk["name"],
            "start_line": chunk["start_line"],
            "end_line": chunk["end_line"],
            "similarity": round(chunk["similarity"], 4),
            "cache_status": chunk["cache_status"],
            "content_hash": chunk["content_hash"],
            "fetched_at": chunk["fetched_at"],
        }
        for chunk in evidence
    ]

    return {
        "answer": answer,
        "candidate_files": candidate_files,
        "retrieved_files": [
            {
                "path": item["path"],
                "characters": len(item["source"]),
                "cache_status": item["cache_status"],
                "content_hash": item["content_hash"],
                "fetched_at": item["fetched_at"],
            }
            for item in retrieved_files
        ],
        "cache_events": cache_events,
        "fetch_errors": fetch_errors,
        "evidence": evidence_metadata,
        "metrics": {
            "files_requested": len(candidate_files),
            "files_retrieved": len(retrieved_files),
            "chunks_created": len(all_chunks),
            "chunks_retrieved": len(evidence),
            "prompt_tokens": prompt_tokens,
            "generated_tokens": len(generated_ids),
            "mcp_seconds": round(mcp_seconds, 3),
            "retrieval_seconds": round(retrieval_seconds, 3),
            "generation_seconds": round(generation_seconds, 3),
            "total_seconds": round(total_seconds, 3),
        },
    }


print("Cached multi-file RAG function is ready.")




