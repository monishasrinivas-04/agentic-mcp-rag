import time
import torch
from kaggle_secrets import UserSecretsClient
from mcp import ClientSession
from mcp.client.streamable_http import streamablehttp_client


# Rule-based file routing. These paths are based on the
# repository files already discovered through GitHub MCP.
MULTI_FILE_ROUTING = {
    "planning": [
        "agents/planning_agent.py",
        "app.py",
        "main.py",
    ],
    "requirements": [
        "app.py",
        "agents/planning_agent.py",
