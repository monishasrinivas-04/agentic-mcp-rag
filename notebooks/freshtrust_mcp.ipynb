import time
import torch
from datetime import datetime, timezone

async def test_grounded_answer(question):
    token = UserSecretsClient().get_secret(
        "GITHUB_PERSONAL_ACCESS_TOKEN"
    )
    path = "agents/planning_agent.py"

    # 1. Retrieve the live source through MCP
    start = time.perf_counter()

    async with streamablehttp_client(
        GITHUB_MCP_URL,
        headers={"Authorization": f"Bearer {token}"},
        timeout=60,
        sse_read_timeout=60,
    ) as (read_stream, write_stream, _):
        async with ClientSession(read_stream, write_stream) as session:
            await session.initialize()
            source = await get_mcp_file(session, path)

    retrieval_time = time.perf_counter() - start
    retrieved_at = datetime.now(timezone.utc).isoformat()

    # 2. Ask Qwen to answer only from the retrieved source
    messages = [
        {
            "role": "system",
            "content": (
                "Answer the question using only the provided source code. "
                "Do not invent features, security controls, or behavior. "
                "If the source does not support a claim, explicitly say "
                "the file does not establish it. Cite the source path. "
                "Keep the answer concise."
            ),
        },
        {
            "role": "user",
            "content": (
                f"Question: {question}\n"
                f"Source file: {path}\n"
                f"Retrieved at UTC: {retrieved_at}\n\n"
                f"Source code:\n{source}"
            ),
        },
    ]

    prompt = tokenizer.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True,
        enable_thinking=False,
    )
    inputs = tokenizer(prompt, return_tensors="pt").to(model.device)

    if torch.cuda.is_available():
        torch.cuda.synchronize()

    start = time.perf_counter()

    with torch.inference_mode():
        output = model.generate(
            **inputs,
            max_new_tokens=220,
            do_sample=False,
            use_cache=True,
            pad_token_id=tokenizer.eos_token_id,
        )

    if torch.cuda.is_available():
        torch.cuda.synchronize()

    generation_time = time.perf_counter() - start

    answer_tokens = output[0][inputs["input_ids"].shape[1]:]
    answer = tokenizer.decode(
        answer_tokens,
        skip_special_tokens=True,
    ).strip()

    # 3. Lightweight phrase-overlap diagnostic
    source_lower = source.lower()
    answer_lower = answer.lower()

    checks = {
        "Planning agent": ["planning agent", "project plans"],
        "Conversation handling": [
            "conversation history",
            "multi-turn",
        ],
        "Plan structure": [
            "project summary",
            "functional requirements",
            "milestones and timeline",
        ],
        "Authentication/security controls": [
            "authentication",
            "role-based access control",
            "data masking",
        ],
    }

    print("=== Grounded Retrieval Test ===")
    print("Repository:", f"{OWNER}/{REPO}")
    print("Source:", path)
    print("Source characters:", len(source))
    print(f"MCP retrieval: {retrieval_time:.2f} seconds")
    print(f"LLM generation: {generation_time:.2f} seconds")
    print("\n=== Qwen3-14B Answer ===\n")
    print(answer)

    print("\n=== Phrase-overlap diagnostic ===")
    for category, phrases in checks.items():
        source_matches = [
            p for p in phrases if p in source_lower
        ]
        answer_matches = [
            p for p in phrases if p in answer_lower
        ]
        print(f"\n{category}")
        print("  In source:", source_matches or "None")
        print("  In answer:", answer_matches or "None")

    print(
        "\nNote: phrase overlap is not proof of factual correctness. "
        "Review the cited source when evaluating individual claims."
    )

    return {
        "source": source,
        "answer": answer,
        "retrieval_seconds": retrieval_time,
        "generation_seconds": generation_time,
        "retrieved_at_utc": retrieved_at,
    }


grounding_result = await test_grounded_answer(
    "How does the planning agent handle multi-turn conversations? "
    "Does this file establish authentication or role-based access control?"
)




import os
import shutil
import pandas as pd
from datetime import datetime, timezone

LATENCY_CSV = "/kaggle/working/freshtrust_latency.csv"

LATENCY_COLUMNS = [
    "timestamp_utc",
    "model",
    "repository",
    "query",
    "retrieval_seconds",
    "generation_seconds",
    "combined_stage_seconds",
    "source_characters",
    "generated_tokens",
    "status",
]


def log_latency(
    retrieval_seconds,
    generation_seconds,
    source_characters,
    generated_tokens=None,
    query="",
    status="success",
):
    """
    Record latency using a fixed CSV schema.

    If the existing CSV is malformed or has incompatible columns,
    back it up and start a clean history file.
    """

    record = {
        "timestamp_utc": datetime.now(timezone.utc).isoformat(),
        "model": "Qwen/Qwen3-14B",
        "repository": (
            f"{OWNER}/{REPO}"
            if "OWNER" in globals() and "REPO" in globals()
            else "Not specified"
        ),
        "query": str(query),
        "retrieval_seconds": float(retrieval_seconds),
        "generation_seconds": float(generation_seconds),
        "combined_stage_seconds": (
            float(retrieval_seconds) + float(generation_seconds)
        ),
        "source_characters": int(source_characters),
        "generated_tokens": (
            int(generated_tokens)
            if generated_tokens is not None
            else None
        ),
        "status": str(status),
    }

    new_row = pd.DataFrame(
        [record],
        columns=LATENCY_COLUMNS,
    )

    # Ensure the output directory exists.
    os.makedirs(
        os.path.dirname(LATENCY_CSV),
        exist_ok=True,
    )

    # Validate the existing history before appending.
    if os.path.exists(LATENCY_CSV):
        try:
            history = pd.read_csv(LATENCY_CSV)

            if list(history.columns) != LATENCY_COLUMNS:
                raise ValueError(
                    "Existing CSV columns do not match the expected schema."
                )

        except (
            pd.errors.ParserError,
            pd.errors.EmptyDataError,
            UnicodeDecodeError,
            ValueError,
        ):
            # Preserve the original file before resetting the history.
            backup_path = (
                LATENCY_CSV
                + ".backup_"
                + datetime.now(timezone.utc).strftime(
                    "%Y%m%d_%H%M%S_%f"
                )
            )

            shutil.copy2(LATENCY_CSV, backup_path)

            print("Existing latency CSV is malformed or incompatible.")
            print("Backup saved to:", backup_path)

            # Start a clean CSV with the expected schema.
            new_row.to_csv(
                LATENCY_CSV,
                index=False,
            )

        else:
            # Append only after confirming the existing schema.
            new_row.to_csv(
                LATENCY_CSV,
                mode="a",
                header=False,
                index=False,
            )

    else:
        # Create a new CSV.
        new_row.to_csv(
            LATENCY_CSV,
            index=False,
        )

    # Read back the verified history.
    history = pd.read_csv(LATENCY_CSV)

    print("Recorded request.")
    print("Total records:", len(history))
    display(history.tail(10))

    # Summarize successful requests only.
    successful = history[
        history["status"].astype(str).str.lower() == "success"
    ]

    if not successful.empty:
        print("\n=== Latency summary ===")

        for column in [
            "retrieval_seconds",
            "generation_seconds",
            "combined_stage_seconds",
        ]:
            values = pd.to_numeric(
                successful[column],
                errors="coerce",
            ).dropna()

            if not values.empty:
                print(
                    f"{column}: "
                    f"median={values.median():.2f}s, "
                    f"P95={values.quantile(0.95):.2f}s"
                )
    else:
        print("\nNo successful requests available for the latency summary.")

    return history


