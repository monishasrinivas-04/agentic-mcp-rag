import torch
from transformers import (
    AutoTokenizer,
    AutoModelForCausalLM,
    BitsAndBytesConfig,
)

MODEL_ID = "Qwen/Qwen3-14B"
MODEL_REVISION = "40c069824f4251a91eefaf281ebe4c544efd3e18"

assert torch.cuda.is_available(), "Enable a GPU accelerator in Kaggle."

quant_config = BitsAndBytesConfig(
    load_in_4bit=True,
    bnb_4bit_quant_type="nf4",
    bnb_4bit_use_double_quant=True,
    bnb_4bit_compute_dtype=torch.float16,
)

print("Loading tokenizer...")
tokenizer = AutoTokenizer.from_pretrained(
    MODEL_ID,
    revision=MODEL_REVISION,
)

print("Loading Qwen3-14B in 4-bit mode...")
model = AutoModelForCausalLM.from_pretrained(
    MODEL_ID,
    revision=MODEL_REVISION,
    quantization_config=quant_config,
    torch_dtype=torch.float16,
    device_map="auto",
    low_cpu_mem_usage=True,
)

model.eval()

print("\nModel loaded successfully.")
print("GPU:", torch.cuda.get_device_name(0))
print(
    "Allocated VRAM:",
    f"{torch.cuda.memory_allocated(0) / 1024**3:.2f} GB",
)




messages = [
    {
        "role": "system",
        "content": (
            "You are the LLM for FreshTrust-MCP, "
            "a repository-aware software engineering assistant. "
            "Answer concisely."
        ),
    },
    {
        "role": "user",
        "content": (
            "Explain in three bullet points how an MCP server "
            "can provide controlled access to live GitHub repository data."
        ),
    },
]

prompt = tokenizer.apply_chat_template(
    messages,
    tokenize=False,
    add_generation_prompt=True,
    enable_thinking=False,
)

inputs = tokenizer(
    prompt,
    return_tensors="pt",
).to(model.device)

with torch.inference_mode():
    output = model.generate(
        **inputs,
        max_new_tokens=180,
        do_sample=False,
        pad_token_id=tokenizer.eos_token_id,
    )

new_tokens = output[0][inputs["input_ids"].shape[1]:]
answer = tokenizer.decode(new_tokens, skip_special_tokens=True)

print(answer)
print(
    "\nPeak GPU memory:",
    f"{torch.cuda.max_memory_allocated(0) / 1024**3:.2f} GB",
)




