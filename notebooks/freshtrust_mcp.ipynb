import os
import json
import hashlib
import tempfile
from datetime import datetime, timezone, timedelta

CACHE_PATH = "/kaggle/working/freshtrust_file_cache.json"
CACHE_TTL_SECONDS = 300  # 5 minutes


def _load_file_cache():
    if not os.path.exists(CACHE_PATH):
        return {}

    try:
        with open(CACHE_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (json.JSONDecodeError, OSError):
        print("Warning: cache file unreadable; starting with an empty cache.")
        return {}


def _save_file_cache(cache):
    """Write atomically to reduce the risk of a partial cache file."""
    directory = os.path.dirname(CACHE_PATH)
    os.makedirs(directory, exist_ok=True)

    fd, temporary_path = tempfile.mkstemp(
        prefix="freshtrust_cache_",
        suffix=".tmp",
        dir=directory,
    )

    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(cache, f, ensure_ascii=False)
        os.replace(temporary_path, CACHE_PATH)
    finally:
        if os.path.exists(temporary_path):
            os.remove(temporary_path)


def _cache_key(owner, repo, path):
    identity = f"{owner}/{repo}/{path}"
    return hashlib.sha256(identity.encode("utf-8")).hexdigest()


def _content_hash(content):
    return hashlib.sha256(content.encode("utf-8")).hexdigest()


def _cache_entry_is_valid(entry, now=None):
    if now is None:
        now = datetime.now(timezone.utc)

    try:
        fetched_at = datetime.fromisoformat(entry["fetched_at"])
        age = (now - fetched_at).total_seconds()

        return (
            isinstance(entry.get("content"), str)
            and bool(entry["content"])
            and 0 <= age < CACHE_TTL_SECONDS
        )
    except (KeyError, TypeError, ValueError):
        return False


def get_cached_file(path):
    """Return an unexpired cached file, or None."""
    cache = _load_file_cache()
    key = _cache_key(OWNER, REPO, path)
    entry = cache.get(key)

    if entry and _cache_entry_is_valid(entry):
        return {
            "path": path,
            "source": entry["content"],
            "cache_status": "cached_within_ttl_not_revalidated",
            "content_hash": entry["content_hash"],
            "fetched_at": entry["fetched_at"],
        }

    return None


def store_cached_file(path, content):
    """Store successfully fetched source and its content hash."""
    cache = _load_file_cache()
    key = _cache_key(OWNER, REPO, path)

    entry = {
        "path": path,
        "content": content,
        "content_hash": _content_hash(content),
        "fetched_at": datetime.now(timezone.utc).isoformat(),
    }

    cache[key] = entry
    _save_file_cache(cache)

    return {
        "path": path,
        "source": content,
        "cache_status": "fetched_live",
        "content_hash": entry["content_hash"],
        "fetched_at": entry["fetched_at"],
    }


def get_stale_cached_file(path):
    """Return expired cached content only for an explicit fallback."""
    cache = _load_file_cache()
    key = _cache_key(OWNER, REPO, path)
    entry = cache.get(key)

    if not entry or not isinstance(entry.get("content"), str):
        return None

    if not entry["content"]:
        return None

    return {
        "path": path,
        "source": entry["content"],
        "cache_status": "stale_fallback_not_revalidated",
        "content_hash": entry.get("content_hash"),
        "fetched_at": entry.get("fetched_at"),
    }


print("FreshTrust file cache configured.")
print("Cache file:", CACHE_PATH)
print("TTL:", CACHE_TTL_SECONDS, "seconds")




