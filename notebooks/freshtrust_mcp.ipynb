from datetime import datetime, timezone
import torch


async def targeted_planning_query(question):
    token = UserSecretsClient().get_secret(
        "GITHUB_PERSONAL_ACCESS_TOKEN"
    )
    path = "agents/planning_agent.py"

    # 1. Retrieve only the relevant file through GitHub MCP.
    async with streamablehttp_client(
        GITHUB_MCP_URL,
        headers={"Authorization": f"Bearer {token}"},
        timeout=60,
        sse_read_timeout=60,
    ) as (read_stream, write_stream, _):
        async with ClientSession(read_stream, write_stream) as session:
            await session.initialize()
            source = await get_mcp_file(session, path)

    retrieved_at = datetime.now(timezone.utc).isoformat()

    # 2. Build a source-grounded prompt.
    messages = [
        {
            "role": "system",
            "content": (
                "You are analyzing source code retrieved from a live "
                "GitHub repository. Answer using only the supplied source. "
                "Do not invent behavior or claim that unshown functions "
                "exist. If the source does not support a detail, state "
                "that clearly. Cite the exact source file path. "
                "Provide a concise, structured explanation."
            ),
        },
        {
            "role": "user",
            "content": (
                f"Question: {question}\n\n"
                f"Repository: {OWNER}/{REPO}\n"
                f"Source file: {path}\n"
                f"Retrieved at (UTC): {retrieved_at}\n\n"
                f"Source code:\n{source}"
            ),
        },
    ]

    prompt = tokenizer.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True,
        enable_thinking=False,
    )

    inputs = tokenizer(
        prompt,
        return_tensors="pt",
    ).to(model.device)

    # 3. Generate the answer with the loaded Qwen3-14B model.
    with torch.inference_mode():
        output = model.generate(
            **inputs,
            max_new_tokens=400,
            do_sample=False,
            pad_token_id=tokenizer.eos_token_id,
        )

    answer_tokens = output[0][inputs["input_ids"].shape[1]:]
    answer = tokenizer.decode(
        answer_tokens,
        skip_special_tokens=True,
    ).strip()

    print("Repository:", f"{OWNER}/{REPO}")
    print("Source file:", path)
    print("Source characters:", len(source))
    print("Retrieved at (UTC):", retrieved_at)
    print("\n=== Qwen3-14B Answer ===\n")
    print(answer)


await targeted_planning_query(
    "How does the planning agent generate structured project plans? "
    "Explain its model configuration, prompt rules, output structure, "
    "and how it handles multi-turn conversations."
)




import time
import torch
from datetime import datetime, timezone

async def evaluate_planning_retrieval():
    token = UserSecretsClient().get_secret(
        "GITHUB_PERSONAL_ACCESS_TOKEN"
    )
    path = "agents/planning_agent.py"

    retrieval_start = time.perf_counter()

    async with streamablehttp_client(
        GITHUB_MCP_URL,
        headers={"Authorization": f"Bearer {token}"},
        timeout=60,
        sse_read_timeout=60,
    ) as (read_stream, write_stream, _):
        async with ClientSession(read_stream, write_stream) as session:
            await session.initialize()
            source = await get_mcp_file(session, path)

    retrieval_seconds = time.perf_counter() - retrieval_start
    retrieved_at = datetime.now(timezone.utc).isoformat()

    messages = [
        {
            "role": "system",
            "content": (
                "You are a source-code analysis assistant. "
                "Use only the supplied file. Separate explicit facts "
                "from details that are not shown. Do not infer runtime "
                "behavior from prompt instructions alone. "
                "Answer in at most 250 words."
            ),
        },
        {
            "role": "user",
            "content": (
                "Explain how this planning agent works. Cover: "
                "(1) configured model, "
                "(2) plan sections specified by the prompt, "
                "(3) functions actually defined for single-turn and "
                "multi-turn planning, "
                "(4) how conversation history is handled, and "
                "(5) any limitations that cannot be confirmed from "
                "this file.\n\n"
                f"File: {path}\n"
                f"Retrieved at UTC: {retrieved_at}\n\n"
                f"Source:\n{source}"
            ),
        },
    ]

    prompt = tokenizer.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True,
        enable_thinking=False,
    )
    inputs = tokenizer(prompt, return_tensors="pt").to(model.device)

    if torch.cuda.is_available():
        torch.cuda.synchronize()

    generation_start = time.perf_counter()

    with torch.inference_mode():
        output = model.generate(
            **inputs,
            max_new_tokens=320,
            do_sample=False,
            pad_token_id=tokenizer.eos_token_id,
        )

    if torch.cuda.is_available():
        torch.cuda.synchronize()

    generation_seconds = time.perf_counter() - generation_start

    answer = tokenizer.decode(
        output[0][inputs["input_ids"].shape[1]:],
        skip_special_tokens=True,
    ).strip()

    print("Repository:", f"{OWNER}/{REPO}")
    print("File:", path)
    print("Source characters:", len(source))
    print(f"MCP retrieval time: {retrieval_seconds:.2f} seconds")
    print(f"LLM generation time: {generation_seconds:.2f} seconds")
    print("\n=== Source-grounded answer ===\n")
    print(answer)


await evaluate_planning_retrieval()




