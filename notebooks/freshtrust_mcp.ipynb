def append_rag_metrics(record):
    # Normalize each record to the same schema.
    normalized = {
        column: record.get(column, None)
        for column in METRIC_COLUMNS
    }

    new_row = pd.DataFrame([normalized], columns=METRIC_COLUMNS)

    if os.path.exists(METRICS_PATH):
        existing = pd.read_csv(METRICS_PATH)

        # Reindex handles missing or extra columns safely.
        existing = existing.reindex(columns=METRIC_COLUMNS)

        combined = pd.concat(
            [existing, new_row],
            ignore_index=True
        )
    else:
        combined = new_row

    combined.to_csv(METRICS_PATH, index=False)

