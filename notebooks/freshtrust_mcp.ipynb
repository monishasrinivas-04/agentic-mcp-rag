)




import ast
import re
from datetime import datetime, timezone
from mcp import ClientSession
from mcp.client.streamable_http import streamablehttp_client
from kaggle_secrets import UserSecretsClient


# ============================================================
# 1. RETRIEVE THE ACTUAL PYTHON SOURCE THROUGH MCP
# ============================================================

SOURCE_PATH = "agents/planning_agent.py"

token = UserSecretsClient().get_secret("GITHUB_PERSONAL_ACCESS_TOKEN")

async def fetch_actual_python_source():
    headers = {"Authorization": f"Bearer {token}"}

    async with streamablehttp_client(
        GITHUB_MCP_URL,
        headers=headers,
        timeout=60,
        sse_read_timeout=60,
    ) as (read_stream, write_stream, _):
        async with ClientSession(read_stream, write_stream) as session:
            await session.initialize()

            response = await session.call_tool(
                "get_file_contents",
                {
                    "owner": OWNER,
                    "repo": REPO,
                    "path": SOURCE_PATH,
                },
            )

            if getattr(response, "isError", False):
                raise RuntimeError(
                    "GitHub MCP returned an error retrieving the planning file."
                )

            # Extract the resource text, not a download-status message.
            blocks = getattr(response, "content", []) or []
            candidates = []

            for block in blocks:
                resource = getattr(block, "resource", None)

                if resource is not None:
                    resource_text = getattr(resource, "text", None)
                    if isinstance(resource_text, str):
                        candidates.append(resource_text)

                    for item in getattr(resource, "contents", []) or []:
                        item_text = getattr(item, "text", None)
                        if isinstance(item_text, str):
                            candidates.append(item_text)

                block_text = getattr(block, "text", None)
                if isinstance(block_text, str):
                    candidates.append(block_text)

            # Select only a candidate that looks like the expected source.
            for candidate in candidates:
                candidate = candidate.strip()

                if (
                    re.match(
                        r"(?s)^(?:#.*\n\s*)*(?:import |from |[A-Z_]+\s*=|def |class |async def )",
                        candidate,
                    )
                    and "PLANNING_SYSTEM_PROMPT" in candidate
                ):
                    return candidate

            raise RuntimeError(
                "MCP did not return the Python source text in a recognized "
                "response block. No status message was parsed as Python. "
                "Inspect the MCP response structure before proceeding."
            )


source = await fetch_actual_python_source()

print("Retrieved file:", SOURCE_PATH)
print("Source characters:", len(source))
print("Retrieved at UTC:", datetime.now(timezone.utc).isoformat())


# ============================================================
# 2. PARSE THE REAL SOURCE
# ============================================================

tree = ast.parse(source, filename=SOURCE_PATH)


# ============================================================
# 3. EXTRACT THE PLANNING SYSTEM PROMPT
# ============================================================

prompt_node = next(
    (
        node
        for node in tree.body
        if isinstance(node, ast.Assign)
        and any(
            isinstance(target, ast.Name)
            and target.id == "PLANNING_SYSTEM_PROMPT"
            for target in node.targets
        )
    ),
    None,
)

if prompt_node is None:
    raise ValueError(
        "The retrieved file does not define PLANNING_SYSTEM_PROMPT."
    )

prompt_value = ast.literal_eval(prompt_node.value)

if not isinstance(prompt_value, str):
    raise ValueError("PLANNING_SYSTEM_PROMPT is not a string.")


# ============================================================
# 4. EXTRACT RELEVANT PROMPT SECTIONS
# ============================================================

section_names = [
    "CONVERSATION RULES",
    "FACTUAL ACCURACY AND ASSUMPTIONS",
    "PROJECT PLAN FORMAT",
]

prompt_sections = {}

for name in section_names:
    start = prompt_value.find(name)

    if start == -1:
        continue

    next_positions = [
        position
        for other in section_names
        if other != name
        for position in [prompt_value.find(other, start + len(name))]
        if position != -1
    ]

    end = min(next_positions) if next_positions else len(prompt_value)
    prompt_sections[name] = prompt_value[start:end].strip()


# ============================================================
# 5. EXTRACT PLANNING FUNCTIONS
# ============================================================

function_sources = []

target_functions = {
    "run_planning_agent",
    "run_planning_turn",
}

for node in tree.body:
    if (
        isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
        and node.name in target_functions
    ):
        function_text = ast.get_source_segment(source, node)

        if function_text:
            function_sources.append(function_text)


# ============================================================
# 6. BUILD TARGETED EVIDENCE
# ============================================================

relevant_parts = list(prompt_sections.values()) + function_sources
relevant_context = "\n\n".join(relevant_parts)

if not relevant_context.strip():
    raise ValueError(
        "The source parsed, but no requested prompt sections or functions "
        "were found."
    )

print("Original source characters:", len(source))
print("Targeted context characters:", len(relevant_context))
print(
    "Context reduction:",
    f"{(1 - len(relevant_context) / len(source)) * 100:.1f}%"
)

print("\n=== Targeted evidence ===\n")
print(relevant_context)




# =========================================================
