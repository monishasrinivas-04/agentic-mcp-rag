import ast
import re

def chunk_python_source(source, path):
    """
    Split Python source into logical units:
    - top-level functions and classes
    - the PLANNING_SYSTEM_PROMPT assignment, split by headings
    - remaining top-level statements where useful
    Each chunk keeps its source line range.
    """
    tree = ast.parse(source)
    lines = source.splitlines()
    chunks = []
    covered_ranges = []

    def add_chunk(text, start_line, end_line, label):
        if text and text.strip():
            chunks.append({
                "text": text.strip(),
                "start_line": start_line,
                "end_line": end_line,
                "label": label,
                "source_file": path,
            })
            covered_ranges.append((start_line, end_line))

    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            text = ast.get_source_segment(source, node)
            add_chunk(
                text,
                node.lineno,
                node.end_lineno,
                f"{type(node).__name__}: {node.name}",
            )

        elif isinstance(node, ast.Assign):
            is_prompt = any(
                isinstance(target, ast.Name)
                and target.id == "PLANNING_SYSTEM_PROMPT"
                for target in node.targets
            )

            if is_prompt:
                prompt = ast.literal_eval(node.value)
                headings = list(re.finditer(
                    r"(?m)^[A-Z][A-Z &/-]+$",
                    prompt,
                ))

                for i, match in enumerate(headings):
                    end = (
                        headings[i + 1].start()
                        if i + 1 < len(headings)
                        else len(prompt)
                    )
                    section = prompt[match.start():end].strip()
                    add_chunk(
                        section,
                        node.lineno,
                        node.end_lineno,
                        f"Prompt section: {match.group().strip()}",
                    )

    # If parsing did not produce any useful chunks, keep the source intact.
    if not chunks and source.strip():
        add_chunk(source, 1, len(lines), "Full source")

    return chunks


structured_chunks = chunk_python_source(
    source,
    "agents/planning_agent.py",
)

print("Structured chunks:", len(structured_chunks))

