        "rag/document_loader.py",
    ],
    "github": [
        "github_auth.py",
        "test_github_mcp.py",
        "app.py",
    ],
}

MULTI_FILE_KEYWORDS = {
    "planning": [
        "planning", "timeline", "milestone", "budget",
        "project plan", "project brief",
    ],
    "requirements": [
        "requirement", "functional", "non-functional",
        "scope", "acceptance criteria",
    ],
