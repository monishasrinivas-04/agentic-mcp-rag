import ast
import re

async def get_mcp_file(session, path):
    result = await session.call_tool(
        "get_file_contents",
        {
            "owner": OWNER,
            "repo": REPO,
            "path": path,
        },
    )

    if result.isError:
        details = "\n".join(
            block.text
            for block in result.content
            if hasattr(block, "text")
        )
        raise RuntimeError(f"MCP retrieval failed for {path}:\n{details}")

    for block in result.content:
        # MCP embedded resource: extract its actual source text.
        resource = getattr(block, "resource", None)
        if resource is not None:
            source = getattr(resource, "text", None)
            if isinstance(source, str):
                return source

            # Some MCP responses wrap the resource in another object.
            contents = getattr(resource, "contents", None)
            if contents:
                for item in contents:
                    source = getattr(item, "text", None)
                    if isinstance(source, str):
                        return source

        # Plain text response or serialized resource representation.
        raw = getattr(block, "text", None)
        if not isinstance(raw, str):
            continue

        if "successfully downloaded text file" not in raw:
            return raw

        # Fallback: parse the Python string representation after text=.
        match = re.search(r"\btext=(.*)$", raw, flags=re.DOTALL)
        if match:
            try:
                source = ast.literal_eval(match.group(1).strip())
                if isinstance(source, str):
                    return source
            except (ValueError, SyntaxError):
                pass

    raise RuntimeError(
        f"MCP returned no extractable source text for {path}. "
        "Inspect result.content to identify its resource structure."
    )


print("Updated MCP file-extraction function.")




import traceback
from kaggle_secrets import UserSecretsClient
from mcp import ClientSession
from mcp.client.streamable_http import streamablehttp_client

GITHUB_MCP_URL = "https://api.githubcopilot.com/mcp/"
OWNER = "monishasrinivas-04"
REPO = "agentic-sdlc-automation"
PATH = "agents/planning_agent.py"


async def diagnose_mcp_read():
    token = UserSecretsClient().get_secret(
        "GITHUB_PERSONAL_ACCESS_TOKEN"
    )

    try:
        async with streamablehttp_client(
            GITHUB_MCP_URL,
            headers={"Authorization": f"Bearer {token}"},
            timeout=60,
            sse_read_timeout=60,
        ) as (read_stream, write_stream, _):
            async with ClientSession(
                read_stream, write_stream
            ) as session:
                print("Initializing MCP session...")
                await session.initialize()
                print("MCP session initialized.")

                print(f"Reading {PATH}...")
                result = await session.call_tool(
                    "get_file_contents",
                    {
                        "owner": OWNER,
                        "repo": REPO,
                        "path": PATH,
                    },
                )

                print("Tool error:", result.isError)
                for block in result.content:
                    if hasattr(block, "text"):
                        print(block.text[:3000])
                    elif hasattr(block, "resource"):
                        print(repr(block.resource)[:3000])

                print("MCP read completed.")

    except BaseException as exc:
        print("\n=== MCP diagnostic exception ===")
        traceback.print_exception(exc)
        raise


await diagnose_mcp_read()




