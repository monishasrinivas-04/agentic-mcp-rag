import os
import subprocess
import shutil
from pathlib import Path
from kaggle_secrets import UserSecretsClient

# ---------------------------------------------------------
# 1. Paths and repository
# ---------------------------------------------------------
REPO_DIR = Path("/kaggle/working/agentic-mcp-rag")
REPO_URL = "https://github.com/monishasrinivas-04/agentic-mcp-rag.git"

NOTEBOOK_SOURCE = Path(
    "/kaggle/working/.virtual_documents/__notebook_source__.ipynb"
)

FILES_TO_COPY = {
    NOTEBOOK_SOURCE: "notebooks/freshtrust_mcp.ipynb",
    Path("/kaggle/working/freshtrust_rag_metrics.csv"):
        "results/freshtrust_rag_metrics.csv",
    Path("/kaggle/working/freshtrust_rag_metrics_v2.csv"):
        "results/freshtrust_rag_metrics_v2.csv",
    Path("/kaggle/working/freshtrust_latency.csv"):
        "results/freshtrust_latency.csv",
}

# ---------------------------------------------------------
# 2. Check the existing directory
# ---------------------------------------------------------
if not REPO_DIR.is_dir():
    raise FileNotFoundError(
        f"Repository directory does not exist: {REPO_DIR}"
    )

check = subprocess.run(
    ["git", "-C", str(REPO_DIR), "rev-parse", "--is-inside-work-tree"],
    capture_output=True,
    text=True,
)

if check.returncode != 0:
    raise RuntimeError(
        f"{REPO_DIR} exists but is not a Git working tree. "
        "Inspect the folder before changing or deleting anything."
    )

remote = subprocess.run(
    ["git", "-C", str(REPO_DIR), "remote", "get-url", "origin"],
    capture_output=True,
    text=True,
    check=True,
).stdout.strip()

# Remove embedded credentials from comparison/output if present.
if "github.com/monishasrinivas-04/agentic-mcp-rag" not in remote:
    raise RuntimeError(
        "The existing folder's origin does not match the expected "
        "agentic-mcp-rag repository. No files were copied or pushed."
    )

print("Existing Git repository verified.")

# ---------------------------------------------------------
# 3. Check notebook exists
# ---------------------------------------------------------
if not NOTEBOOK_SOURCE.is_file():
    raise FileNotFoundError(
        f"Notebook not found: {NOTEBOOK_SOURCE}"
    )

# ---------------------------------------------------------
# 4. Copy the notebook and available CSVs
# ---------------------------------------------------------
staged_paths = []

for source, relative_destination in FILES_TO_COPY.items():
    if not source.is_file():
        print("Skipping missing optional file:", source.name)
        continue

    destination = REPO_DIR / relative_destination
    destination.parent.mkdir(parents=True, exist_ok=True)

    # Avoid silently replacing an existing notebook.
    if destination.exists() and relative_destination.endswith(".ipynb"):
        print("Notebook destination already exists:", destination)
        print("Not overwriting it. Review that file before proceeding.")
        continue

    shutil.copy2(source, destination)
    staged_paths.append(relative_destination)
    print("Copied:", relative_destination)

if not staged_paths:
    raise RuntimeError(
        "No new files were copied. Check the notebook destination "
        "and existing files before retrying."
    )

# ---------------------------------------------------------
# 5. Stage only the selected files
# ---------------------------------------------------------
subprocess.run(
    ["git", "-C", str(REPO_DIR), "add", "--", *staged_paths],
    check=True,
)

subprocess.run(
    ["git", "-C", str(REPO_DIR), "status", "--short"],
    check=True,
)

print("\nReview the staged changes above before committing.")
print("If they are correct, run the commit-and-push cell below.")




