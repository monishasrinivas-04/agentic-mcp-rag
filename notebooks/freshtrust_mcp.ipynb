        "freshness", "provenance",
    ],
    "github": [
        "github", "mcp", "repository", "repo",
        "authentication", "token", "source control",
    ],
}


def select_repository_files(question, max_files=4):
    """Select candidate files using transparent keyword routing."""
    text = question.lower()
    scores = {}

    for category, keywords in MULTI_FILE_KEYWORDS.items():
        score = sum(1 for word in keywords if word in text)

        if score:
            for path in MULTI_FILE_ROUTING[category]:
                scores[path] = scores.get(path, 0) + score

    if not scores:
        return [
            "app.py",
            "main.py",
            "agents/planning_agent.py",
            "rag/retriever.py",
        ][:max_files]

    ordered = sorted(
        scores,
        key=lambda path: (-scores[path], path)
    )

    return ordered[:max_files]


def chunk_repository_file(source, path):
    """Use structure-aware chunks for Python and line chunks otherwise."""
    if path.endswith(".py"):
        return chunk_python_source_v2(source, path)

    lines = source.splitlines()
    chunks = []
    window_size = 35
    overlap = 5
    step = window_size - overlap

    for start in range(0, len(lines), step):
        end = min(start + window_size, len(lines))
        text = "\n".join(lines[start:end]).strip()

        if text:
            chunks.append({
                "path": path,
                "kind": "LineWindow",
                "name": f"lines_{start + 1}_{end}",
                "start_line": start + 1,
                "end_line": end,
                "text": text,
            })

    return chunks


async def freshtrust_rag_multi(
    question,
    max_files=4,
    top_k=5,
    max_new_tokens=180,
):
    """
    Multi-file RAG:
    1. Select candidate repository files.
    2. Fetch each file using authenticated GitHub MCP.
    3. Rank chunks across all successfully retrieved files.
    4. Generate a grounded answer with Qwen3-14B.

    No direct GitHub REST API fallback is used.
    """
    total_start = time.perf_counter()

    candidate_files = select_repository_files(
        question,
        max_files=max_files
    )

    token = UserSecretsClient().get_secret(
        "GITHUB_PERSONAL_ACCESS_TOKEN"
    )
    headers = {"Authorization": f"Bearer {token}"}

    retrieved_files = []
    fetch_errors = []
    mcp_start = time.perf_counter()

    async with streamablehttp_client(
        GITHUB_MCP_URL,
        headers=headers
    ) as (read_stream, write_stream, _):
        async with ClientSession(read_stream, write_stream) as session:
            await session.initialize()

            for path in candidate_files:
                try:
                    source = await get_mcp_file(session, path)

                    if isinstance(source, str) and source.strip():
                        retrieved_files.append({
                            "path": path,
                            "source": source,
                        })
                    else:
                        fetch_errors.append({
                            "path": path,
                            "error": "No readable text returned",
                        })

                except Exception as exc:
                    # Continue with other files; never use REST fallback.
                    fetch_errors.append({
                        "path": path,
                        "error": str(exc)[:250],
                    })

    mcp_seconds = time.perf_counter() - mcp_start

    if not retrieved_files:
        raise RuntimeError(
            "MCP could not retrieve any candidate files. "
            f"Candidates: {candidate_files}. "
            f"Errors: {fetch_errors}"
        )

    retrieval_start = time.perf_counter()

    all_chunks = []
    for item in retrieved_files:
        all_chunks.extend(
            chunk_repository_file(item["source"], item["path"])
        )

    ranked_chunks = rank_chunks(question, all_chunks)
    evidence = select_diverse_chunks(
        ranked_chunks,
        top_k=top_k
    )

    retrieval_seconds = time.perf_counter() - retrieval_start

    if not evidence:
        raise RuntimeError("No relevant chunks were retrieved.")

    prompt = build_rag_prompt(question, evidence)

    # Ask Qwen for only the final answer, without a reasoning preamble.
    prompt += "\n/no_think"

    generation_start = time.perf_counter()

    inputs = tokenizer(
        prompt,
        return_tensors="pt",
        truncation=True,
        max_length=6000
    ).to(model.device)

    prompt_tokens = int(inputs["input_ids"].shape[1])

    with torch.inference_mode():
        output = model.generate(
            **inputs,
            max_new_tokens=max_new_tokens,
            do_sample=False,
            pad_token_id=tokenizer.eos_token_id,
        )

    generated_ids = output[0][prompt_tokens:]
    answer = tokenizer.decode(
        generated_ids,
        skip_special_tokens=True
    ).strip()

    generation_seconds = time.perf_counter() - generation_start
    total_seconds = time.perf_counter() - total_start

    evidence_metadata = [
        {
            "path": item["path"],
            "section": item["name"],
            "start_line": item["start_line"],
            "end_line": item["end_line"],
            "similarity": round(item["similarity"], 4),
        }
        for item in evidence
    ]

    return {
        "answer": answer,
        "candidate_files": candidate_files,
        "retrieved_files": [
            {
                "path": item["path"],
                "characters": len(item["source"]),
            }
            for item in retrieved_files
        ],
        "fetch_errors": fetch_errors,
        "evidence": evidence_metadata,
        "metrics": {
            "files_requested": len(candidate_files),
            "files_retrieved": len(retrieved_files),
            "chunks_created": len(all_chunks),
            "chunks_retrieved": len(evidence),
            "prompt_tokens": prompt_tokens,
            "generated_tokens": len(generated_ids),
            "mcp_seconds": round(mcp_seconds, 3),
            "retrieval_seconds": round(retrieval_seconds, 3),
            "generation_seconds": round(generation_seconds, 3),
            "total_seconds": round(total_seconds, 3),
        },
    }


