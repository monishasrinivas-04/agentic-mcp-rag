# ---------------------------------------------------------
# 2. Source validation
# ---------------------------------------------------------

def validate_source_text(source, path):
    """Reject empty responses and MCP status messages."""

    if not isinstance(source, str):
        raise TypeError(
            f"MCP did not return a string for {path}. "
            f"Returned type: {type(source).__name__}"
        )

    source = source.strip()

    if not source:
        raise ValueError(
            f"MCP returned an empty file for {path}."
        )

    status_phrases = [
        "successfully downloaded text file",
        "successfully downloaded file",
        "downloaded successfully",
        "file contents are available",
    ]

    if any(
        phrase in source.lower()
        for phrase in status_phrases
    ):
        raise ValueError(
            f"MCP returned a download confirmation instead of "
            f"the source code for {path}. Fix get_mcp_file() "
            "to extract the actual file contents from the MCP "
            "response before running this RAG pipeline."
        )

    return source


# ---------------------------------------------------------
# 3. Split source into overlapping line-numbered chunks
# ---------------------------------------------------------

def chunk_source_by_lines(
    source,
    chunk_lines=30,
    overlap_lines=5,
):
    if chunk_lines < 1:
        raise ValueError("chunk_lines must be at least 1.")

    if not 0 <= overlap_lines < chunk_lines:
        raise ValueError(
            "overlap_lines must be >= 0 and less than chunk_lines."
        )

    lines = source.splitlines()
    chunks = []
    start = 0

    while start < len(lines):
        end = min(start + chunk_lines, len(lines))
        text = "\n".join(lines[start:end])

        if text.strip():
            chunks.append({
                "text": text,
                "start_line": start + 1,
                "end_line": end,
            })

        if end == len(lines):
            break

        start = end - overlap_lines

    return chunks


# ---------------------------------------------------------
# 4. Rank chunks by cosine similarity
# ---------------------------------------------------------

def retrieve_relevant_chunks(
    question,
    chunks,
    top_k=4,
):
    if not question or not question.strip():
        raise ValueError("Question cannot be empty.")

    if top_k < 1:
        raise ValueError("top_k must be at least 1.")

    if not chunks:
        return []

    texts = [chunk["text"] for chunk in chunks]

    embeddings = retrieval_embedder.encode(
        [question] + texts,
        normalize_embeddings=True,
        convert_to_numpy=True,
        show_progress_bar=False,
    )

    query_vector = embeddings[0]
    chunk_vectors = embeddings[1:]
    scores = chunk_vectors @ query_vector

    ranked_indices = np.argsort(scores)[::-1][:top_k]

    results = []

    for index in ranked_indices:
        item = dict(chunks[int(index)])
        item["similarity"] = float(scores[int(index)])
        results.append(item)

    return results


# ---------------------------------------------------------
# 5. Fetch one live file through GitHub MCP
# ---------------------------------------------------------

async def fetch_source_via_mcp(path):
    token = UserSecretsClient().get_secret(
        "GITHUB_PERSONAL_ACCESS_TOKEN"
    )

    if not token or not token.strip():
        raise ValueError(
            "The GITHUB_PERSONAL_ACCESS_TOKEN Kaggle secret is empty."
        )

    async with streamablehttp_client(
        GITHUB_MCP_URL,
        headers={"Authorization": f"Bearer {token}"},
        timeout=60,
        sse_read_timeout=60,
    ) as (read_stream, write_stream, _):

        async with ClientSession(
            read_stream,
            write_stream,
        ) as session:

            await session.initialize()

            source = await get_mcp_file(session, path)

    return validate_source_text(source, path)


