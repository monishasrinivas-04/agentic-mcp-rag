            if v2_columns and v2_columns != list(metrics_df.columns):
                raise ValueError(
                    "The existing v2 metrics CSV has a different "
                    "column schema. No existing metrics were overwritten."
                )

            metrics_df.to_csv(
                metrics_path,
                mode="a" if os.path.exists(metrics_path) else "w",
                header=not os.path.exists(metrics_path),
                index=False,
            )
    else:
        metrics_df.to_csv(metrics_path, index=False)

    # Display results only after successful retrieval and generation.
    display(Markdown("## FreshTrust-MCP — RAG Results"))

    print("Question:", question)
    print("Repository:", f"{OWNER}/{REPO}")
    print("Source file:", source_path)
    print("Source characters:", len(source))
    print("Chunks created:", len(chunks))
    print("Chunks retrieved:", len(ranked))

    display(Markdown("### Retrieved evidence"))

    for rank, item in enumerate(ranked, start=1):
